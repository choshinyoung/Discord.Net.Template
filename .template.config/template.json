{
  "$schema": "http://json.schemastore.org/template",
  "author": "choshinyoung",
  "classifications": ["Common", "Console"],
  "identity": "Discord.Net.Template",
  "name": "Discord.Net Template",
  "shortName": "dnettemplate",
  "sourceName": "Discord.Net.Template",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "sudo": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include owner-only sudo commands (run C# code, shell, su, reload)."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!sudo)",
          "exclude": ["Modules/Commands/Sudo.cs", "Utils/RegexUtil.cs"]
        }
      ]
    }
  ]
}
